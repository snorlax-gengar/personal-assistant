# 개인비서 Blanc 비밀키 (이 파일을 .env 로 복사해서 값을 채우세요)
# .env 는 git에 올라가지 않습니다. GitHub Actions에는 같은 이름으로 Secrets에 등록하세요.

# 공공데이터포털 일반 인증키 (Encoding/Decoding 아무거나) — 청약홈 + LH 공고
DATA_GO_KR_KEY=
# https://finnhub.io  — 미국 실적 발표
FINNHUB_KEY=
# https://opendart.fss.or.kr — 국내 실적 공시
DART_KEY=
# 텔레그램 (BotFather에서 재발급한 새 토큰)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
